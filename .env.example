# Copia este archivo como .env.local y completa los valores.
# En Vercel, configúralos en Project → Settings → Environment Variables.

# Conexión a Postgres (Neon). Vercel la crea sola al agregar Neon desde Storage.
DATABASE_URL=

# Contraseña para entrar a /admin. Elige una larga.
ADMIN_PASSWORD=

# Texto aleatorio de 32+ caracteres para firmar la sesión del admin.
# Puedes generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
